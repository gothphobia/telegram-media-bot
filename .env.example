BOT_TOKEN=PUT_YOUR_BOTFATHER_TOKEN_HERE
# Optional: comma-separated Telegram user IDs. Empty means everyone.
ALLOWED_USER_IDS=
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_TIMEOUT=900
MAX_DURATION_SECONDS=7200
# Decimal MB. Public Telegram API: keep at 49. Local API: up to 1990.
MAX_UPLOAD_MB=49
# Optional: URL of your existing local Telegram Bot API server.
TELEGRAM_API_BASE=
# Optional Netscape cookies file, mounted/readable by this process.
COOKIES_FILE=
